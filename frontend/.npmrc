# @bomb.sh/tab (aus @nuxt/cli) deklariert cac/commander als optionale Peers, deren
# Ranges mit den hoisted Versionen (cac@7, commander@11) kollidieren. npm-arborist
# lehnt die Lockdatei sonst mit "Missing from lock file" ab — sowohl bei npm ci als
# auch beim Regenerieren der Lockdatei. legacy-peer-deps umgeht diese Peer-Prüfung.
legacy-peer-deps=true
