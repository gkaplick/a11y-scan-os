# Web-Container: Nuxt 4 SPA (ssr: false) — Nitro-Server serviert das Shell-HTML
# und proxied /api und /ws ans API-Service (API_URL wird beim Build eingebacken).
#
# Build-Arg API_URL (z. B. http://api:8000 im Compose-Netzwerk) wird in
# nuxt.config.ts als routeRules-Proxy-Ziel verwendet.
FROM node:22-alpine AS build
ARG API_URL=http://localhost:8000
ENV API_URL=$API_URL

WORKDIR /app
COPY frontend/package.json frontend/package-lock.json frontend/.npmrc ./
# npm ci liest die Lockdatei direkt (kein Arborist-Resolve) — robust gegen den
# "edgesOut"-Bug älterer npm-Versionen und reproduzierbar.
# --legacy-peer-deps: @bomb.sh/tab (aus @nuxt/cli) deklariert cac/commander als
# optionale Peers, deren Ranges mit den hoisted Versionen (cac@7, commander@11)
# kollidieren; arborist lehnt die lockfile sonst mit "Missing from lock file" ab.
RUN npm ci --no-audit --no-fund --legacy-peer-deps
COPY frontend/ .
RUN npm run build

FROM node:22-alpine
WORKDIR /app
COPY --from=build /app/.output ./.output
COPY --from=build /app/node_modules ./node_modules

ENV NITRO_PORT=3000 \
    NITRO_HOST=0.0.0.0 \
    API_URL=http://api:8000

EXPOSE 3000
CMD ["node", ".output/server/index.mjs"]
